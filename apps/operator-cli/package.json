{
  "name": "@rip-dvd/operator-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "rip-dvd": "dist/entry.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm --filter @rip-dvd/config --filter @rip-dvd/data-access --filter @rip-dvd/worker-runtime --filter @rip-dvd/application build && pnpm build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rip-dvd/application": "workspace:*",
    "@rip-dvd/config": "workspace:*",
    "@rip-dvd/data-access": "workspace:*"
  },
  "devDependencies": {
    "@rip-dvd/worker-runtime": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4"
  }
}
