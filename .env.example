# Compose uses writable named volumes by default. Uncomment these optional
# overrides to bind-mount host libraries after preparing their ownership as
# documented in README.md.
# RIP_DVD_MEDIA_LIBRARY_HOST_PATH=./.local/media
# RIP_DVD_ORIGINALS_LIBRARY_HOST_PATH=./.local/originals
# SQLite backups are written here by scripts/compose-backup.sh. Keep a second
# copy outside the Docker host.
RIP_DVD_BACKUP_HOST_PATH=./backups
# The dashboard is unauthenticated and binds only to loopback by default.
# Compose derives its trusted localhost origin from RIP_DVD_WEB_PORT. LAN or
# reverse-proxy exposure requires an explicit bind address and exact origin.
RIP_DVD_WEB_BIND_ADDRESS=127.0.0.1
RIP_DVD_WEB_PORT=3000
# RIP_DVD_WEB_TRUSTED_ORIGIN=http://dvd-host.example:3000

# Backward-compatible single-drive defaults. Prefer stable serials in
# .local/optical-drives.json; scripts/compose-start.sh then generates a narrow
# read-only block/SCSI-generic override and supersedes both paths dynamically.
# Set the numeric GID that owns both device nodes on the host.
RIP_DVD_ARCHIVE_DEVICE_PATH=/dev/sr0
RIP_DVD_ARCHIVE_CSS_DEVICE_PATH=/dev/sg1
RIP_DVD_OPTICAL_DEVICE_GID=24
RIP_DVD_WORKER_POLL_INTERVAL_MS=5000
RIP_DVD_ARCHIVE_WORKER_CONCURRENCY=2
RIP_DVD_ENCODE_WORKER_CONCURRENCY=1

# Relative worker scheduling defaults. CPU shares apply only under contention;
# ionice support depends on the native Linux I/O scheduler and cgroup driver.
RIP_DVD_ARCHIVE_CPU_SHARES=512
RIP_DVD_ARCHIVE_NICE_LEVEL=10
RIP_DVD_ARCHIVE_IONICE_CLASS=2
RIP_DVD_ARCHIVE_IONICE_LEVEL=7
RIP_DVD_ENCODE_CPU_SHARES=128
RIP_DVD_ENCODE_NICE_LEVEL=19
RIP_DVD_ENCODE_IONICE_CLASS=3
RIP_DVD_ENCODE_IONICE_LEVEL=7
# Enable only after confirming native Linux cgroup and I/O scheduler support.
RIP_DVD_ENABLE_BLOCK_IO_WEIGHTS=0
