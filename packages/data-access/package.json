{
  "name": "@rip-dvd/data-access",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./dvd-scan": {
      "types": "./src/dvd-scan.ts",
      "default": "./dist/dvd-scan.js"
    },
    "./dvd-content-id": {
      "types": "./src/dvd-content-id.ts",
      "default": "./dist/dvd-content-id.js"
    },
    "./catalog-kinds": {
      "types": "./src/catalog-kinds.ts",
      "default": "./dist/catalog-kinds.js"
    },
    "./disc-selection-source-identity": {
      "types": "./src/disc-selection-source-identity.ts",
      "default": "./dist/disc-selection-source-identity.js"
    },
    "./legacy-sidecars": {
      "types": "./src/legacy-sidecars.ts",
      "default": "./dist/legacy-sidecars.js"
    }
  },
  "files": ["dist", "drizzle"],
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "test": "pnpm build && vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
